{
  "manifest_version": 3,
  "name": "RoPlus - Roblox, Supercharged",
  "version": "0.8.0",
  "description": "Enhances Roblox with a server browser, avatar sandbox, playtime stats, profile themes, game reviews, and trading tools. All free.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/service-worker.ts-BzjAB408.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/hash-capture.ts-IYK6AqcZ.js"
      ],
      "matches": [
        "*://*.roblox.com/*"
      ],
      "run_at": "document_start"
    },
    {
      "js": [],
      "matches": [
        "*://*.roblox.com/stats",
        "*://*.roblox.com/stats/*",
        "*://*.roblox.com/*/stats",
        "*://*.roblox.com/*/stats/*"
      ],
      "css": [
        "css/hide-404.css"
      ],
      "run_at": "document_start"
    },
    {
      "js": [],
      "matches": [
        "*://*.roblox.com/banned-users/*",
        "*://*.roblox.com/*/banned-users/*"
      ],
      "css": [
        "css/hide-404.css"
      ],
      "run_at": "document_start"
    },
    {
      "js": [
        "assets/index.ts-loader-CBcX91Wz.js"
      ],
      "matches": [
        "*://*.roblox.com/*",
        "*://create.roblox.com/*"
      ],
      "run_at": "document_start",
      "css": [
        "assets/index-BRJHMZQW.css"
      ]
    },
    {
      "js": [
        "assets/auth-callback.ts-loader-BuNbf0Kb.js"
      ],
      "matches": [
        "*://roplus.dev/auth/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "clipboardWrite",
    "cookies",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gamejoin_headers",
        "enabled": true,
        "path": "rules/gamejoin_headers.json"
      }
    ]
  },
  "host_permissions": [
    "*://*.roblox.com/*",
    "*://create.roblox.com/*",
    "*://*.rbxcdn.com/*",
    "*://rolimons.com/*",
    "*://www.rolimons.com/*",
    "*://api.rolimons.com/*",
    "*://roplus.dev/*"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.roblox.com/*"
      ],
      "resources": [
        "icons/*",
        "assets/*",
        "scripts/*",
        "css/*",
        "assets/hash-capture.ts-IYK6AqcZ.js"
      ]
    },
    {
      "matches": [
        "*://*.roblox.com/*",
        "*://create.roblox.com/*"
      ],
      "resources": [
        "assets/common_alpha-BP5DZFFF.png",
        "assets/explosion01_core_alpha-BVS8zQeq.png",
        "assets/explosion01_core_main-C01YVECB.png",
        "assets/explosion01_implosion_color-DIW9619R.png",
        "assets/explosion01_implosion_main-DyBHDmbm.png",
        "assets/explosion01_shockwave_main-D-qAaBhc.png",
        "assets/explosion01_smoke_alpha-BwURFM5W.png",
        "assets/explosion01_smoke_color_new-Dg5hh4v-.png",
        "assets/explosion01_smoke_main-CVha17Ey.png",
        "assets/explosion_alpha-CISQDbhY.png",
        "assets/explosion_color-CRx21JZH.png",
        "assets/fire_alpha-R8vAx4-i.png",
        "assets/fire_color-gvrgBNvO.png",
        "assets/fire_main-B2CMh_Eu.png",
        "assets/fire_sparks_color-bMmg068s.png",
        "assets/fire_sparks_main-vuV4J01M.png",
        "assets/forcefield_alpha-BdrAQ5xT.png",
        "assets/forcefield_glow_alpha-BvSWmdd7.png",
        "assets/forcefield_glow_color-CSPBA7zF.png",
        "assets/forcefield_glow_main-D79zatBp.png",
        "assets/forcefield_vortex_color-CiXEhyO4.png",
        "assets/forcefield_vortex_main-DWmiEvLS.png",
        "assets/legacy_fire_alpha_color-Drbpa9hs.png",
        "assets/smoke_color-DfGZ0Y-q.png",
        "assets/smoke_main-C8ynil-K.png",
        "assets/sparkles_color-BIhOEDzc.png",
        "assets/sparkles_main-Be0i_ErF.png",
        "assets/square_particle-CtBpaXnh.png",
        "assets/px-WNzKO26L.jpg",
        "assets/nx-TerJJEIh.jpg",
        "assets/py-DR08ZQc0.jpg",
        "assets/ny-Cw5jBpyT.jpg",
        "assets/pz-COS-6mQj.jpg",
        "assets/nz-CIYZAnc8.jpg",
        "assets/logger-BetE19VS.js",
        "assets/Toast-C2LjXNHC.js",
        "assets/roplus-social-CHE3y69o.js",
        "assets/roblox-D2WhtVzb.js",
        "assets/rolimons-CsaWR8ms.js",
        "assets/RoProImportModal-BXgvK7Vh.js",
        "assets/browserDetection-CcwcEYyL.js",
        "assets/jszip.min-eCUmDXBf.js",
        "assets/index.ts-BG_nHnXI.js"
      ]
    },
    {
      "matches": [
        "*://roplus.dev/*"
      ],
      "resources": [
        "assets/logger-BetE19VS.js",
        "assets/auth-callback.ts-D3iaAY9d.js"
      ]
    }
  ]
}